:root {
  color: #18231e;
  background: #f5f1e8;
  font-family: Inter, ui-sans-serif, system-ui, sans-serif;
}

* { box-sizing: border-box; }
body { margin: 0; min-width: 320px; min-height: 100vh; }
main { width: min(760px, calc(100% - 32px)); margin: 0 auto; padding: 12vh 0; }
main > span { color: #1e4a39; font-size: 12px; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; }
h1 { margin: 12px 0; font-size: clamp(42px, 8vw, 72px); line-height: 1; letter-spacing: -0.05em; }
p { color: #667068; font-size: 18px; line-height: 1.6; }
section { margin-top: 48px; padding: 24px; border: 1px solid #d9d8cf; border-radius: 20px; background: #fffdf8; }
section p { margin-bottom: 0; font-size: 15px; }
