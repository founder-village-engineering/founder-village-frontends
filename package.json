{
  "name": "founder-village-frontends",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check:local": "npm run format:check && npm run security:scan && npm run security:scan -- --history && npm run contracts:workspace && npm run check && npm audit --omit=dev --audit-level=high && npm run test:e2e",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.tooling.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "contracts:check": "tsx scripts/check-contract-snapshots.ts",
    "contracts:workspace": "node --import tsx ../founder-village-runtime/scripts/sync-frontend-contracts.ts --check --frontends-root .",
    "pages": "tsx scripts/pages.ts",
    "pages:plan": "tsx scripts/pages.ts plan --app founder-village-app",
    "pages:provision": "tsx scripts/pages.ts provision --app founder-village-app",
    "pages:deploy": "tsx scripts/pages.ts deploy --app founder-village-app",
    "pages:verify": "tsx scripts/pages.ts verify --app founder-village-app",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "security:scan": "node scripts/security-scan.ts",
    "check": "npm run contracts:check && npm run typecheck && npm test && npm run build && npm run pages:plan && npm run pages -- plan --app founder-village-team",
    "dev:team": "npm run dev -w @founder-village/founder-village-team",
    "dev:app": "npm run dev -w @founder-village/founder-village-app"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.166.0",
    "zod": "4.6.7"
  },
  "overrides": {
    "@expo/fingerprint": {
      "minimatch": "11.0.9"
    }
  }
}
