{
  "name": "@founder-village/founder-village-members",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "pages:plan": "tsx ../../scripts/pages.ts plan --app founder-village-members",
    "pages:deploy": "tsx ../../scripts/pages.ts deploy --app founder-village-members",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "native:export": "expo export --platform ios --platform android --output-dir .state/native-export"
  },
  "dependencies": {
    "@founder-village/frontend-platform": "*",
    "expo": "58.0.26",
    "expo-auth-session": "58.0.19",
    "expo-crypto": "58.0.8",
    "expo-secure-store": "58.0.3",
    "expo-splash-screen": "58.0.14",
    "expo-status-bar": "58.0.5",
    "expo-system-ui": "58.0.7",
    "expo-web-browser": "58.1.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-web": "0.21.4",
    "zod": "4.6.7"
  },
  "main": "src/register.ts",
  "devDependencies": {
    "@types/qrcode": "1.5.6"
  }
}
